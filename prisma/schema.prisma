// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  studentId      Int             @id @default(autoincrement())
  userName       String          @unique
  email          String?         @unique
  password       String
  StudentProfile StudentProfile?
}

model StudentProfile {
  profileId          Int       @id @default(autoincrement())
  firstName          String?
  middleName         String?
  lastName           String?
  dateOfBirth        DateTime?
  gender             String?
  section            String?
  phoneNumber        String?
  address            String?
  grade              String?
  parentName         String?
  parentContact      String?
  student            Student   @relation(fields: [studentId], references: [studentId])
  studentId          Int       @unique // Makes this a one-to-one relation
  scores             Score[]
  registeredDate     DateTime  @default(now())
  schoolYear         Int?
  lastSchoolAttended String?
  teacher            Teacher   @relation(fields: [teacherId], references: [teacherId])
  teacherId          Int
}

model Teacher {
  teacherId      Int              @id @default(autoincrement())
  email          String           @unique
  password       String
  createdAt      DateTime         @default(now())
  profile        TeacherProfile? // One-to-one relation with TeacherProfile
  StudentProfile StudentProfile[]
}

model TeacherProfile {
  profileId      Int        @id @default(autoincrement())
  firstName      String?
  lastName       String?
  dateOfBirth    DateTime?
  phoneNumber    String?
  address        String?
  qualification  String?
  specialization String?
  experience     Int?
  teacher        Teacher    @relation(fields: [teacherId], references: [teacherId])
  teacherId      Int        @unique // Makes this a one-to-one relation
  tests          Test[]
  materials      Material[]
  joinedDate     DateTime   @default(now())
}

model Material {
  materialId              Int             @id @default(autoincrement())
  title                   String
  content                 String // Can store file path or content
  uploadedDate            DateTime        @default(now())
  tests                   Test[]
  TeacherProfile          TeacherProfile? @relation(fields: [teacherProfileProfileId], references: [profileId])
  teacherProfileProfileId Int?
}

model Test {
  testId                  Int             @id @default(autoincrement())
  title                   String
  createdDate             DateTime        @default(now())
  startTime               DateTime
  endTime                 DateTime
  material                Material        @relation(fields: [materialId], references: [materialId])
  materialId              Int
  questions               Question[]
  scores                  Score[]
  TeacherProfile          TeacherProfile? @relation(fields: [teacherProfileProfileId], references: [profileId])
  teacherProfileProfileId Int?
}

model Question {
  questionId    Int    @id @default(autoincrement())
  questionText  String
  options       Json // Store options as a JSON array
  correctOption String
  test          Test   @relation(fields: [testId], references: [testId])
  testId        Int
}

model Score {
  scoreId                 Int             @id @default(autoincrement())
  score                   Int
  dateTaken               DateTime        @default(now())
  test                    Test            @relation(fields: [testId], references: [testId])
  testId                  Int
  StudentProfile          StudentProfile? @relation(fields: [studentProfileProfileId], references: [profileId])
  studentProfileProfileId Int?
}
